# URL de "Obtener URL del calendario" en Moodle (es personal, no la compartas)
MOODLE_CALENDAR_URL=pega_aqui_tu_url
INTERVALO_MINUTOS=180
# Estudiante dueño del calendario real (en la base relacional es el id 1)
ESTUDIANTE_ID=1

# MinIO (datalake). Claves de mínimo 8 caracteres
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=cambia_esta_clave
MINIO_BUCKET=datalake
MINIO_ENDPOINT=minio:9000

# MySQL (base relacional)
MYSQL_ROOT_PASSWORD=cambia_clave_root
MYSQL_DATABASE=entregas
MYSQL_USER=app
MYSQL_PASSWORD=cambia_clave_app
